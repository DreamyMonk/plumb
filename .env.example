# Copy to .env.local and add your key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional: where Plumb keeps its database, charts and chats (default: ./.data)
# PLUMB_DATA_DIR=

# Optional: only for Kafka clusters that use SASL, such as Confluent Cloud
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
